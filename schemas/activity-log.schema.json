{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-research.local/contracts/v1/activity-log.schema.json",
  "title": "DRS-1.1 Research Activity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "activity_id",
    "branch_id",
    "question_ids",
    "purpose",
    "observed_state_ref",
    "action_type",
    "target_locator",
    "action_payload",
    "started_at",
    "finished_at",
    "final_url",
    "outcome",
    "output_capture_ids",
    "limitation",
    "tool_details"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "activity_id": {"type": "string", "minLength": 1},
    "branch_id": {"enum": ["documentary", "social"]},
    "question_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "purpose": {"type": "string", "minLength": 1},
    "observed_state_ref": {"type": ["string", "null"]},
    "action_type": {
      "enum": ["navigate", "search", "filter", "open", "expand", "paginate", "scroll", "transcript", "extract", "api_fetch"]
    },
    "target_locator": {"type": ["object", "null"]},
    "action_payload": {"type": ["object", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "final_url": {"type": "string", "format": "uri"},
    "outcome": {"enum": ["success", "partial", "blocked", "timeout", "error"]},
    "output_capture_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitation": {"type": ["string", "null"]},
    "tool_details": {
      "type": "object",
      "required": ["engine", "mode", "response_status"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "response_status": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    }
  }
}
