{
  "schema_version": "1.0",
  "mode": "R1",
  "purpose": "general_research",
  "subject": {
    "class": "organization",
    "name_or_id": "organization:target"
  },
  "authorization": {
    "status": "not_required",
    "method": "",
    "scope_hash": "",
    "reviewed_by": "",
    "reviewed_at": "",
    "expires_at": ""
  },
  "scope": {
    "allowed_entities": [],
    "allowed_domains": [],
    "source_access_classes": [
      "standard_public",
      "public_reporting"
    ],
    "data_classes": [
      "public",
      "professional"
    ],
    "max_sources": 500,
    "max_depth": 3,
    "stop_after_no_new_claims": 3
  },
  "access": {
